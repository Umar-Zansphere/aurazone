# ==============================================================================
# AuraZone Admin Dashboard Environment Configuration (.env.example)
# ==============================================================================

# Server & Routing
PORT=3001
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Backend API URL (Used for client requests and Next.js rewrites: /api/:path* -> NEXT_PUBLIC_API_URL/api/:path*)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Authentication & Session Verification
# Must match backend JWT_SECRET for Next.js middleware and route handlers to verify admin tokens
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long

# Web Push Notifications (Public VAPID key)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# Application Metadata
NEXT_PUBLIC_APP_VERSION=1.0.0

# AI Product Content Generator (OpenRouter integration in /api/ai/product-content)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
