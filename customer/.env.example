# ==============================================================================
# AuraZone Customer Storefront Environment Configuration (.env.example)
# ==============================================================================

# Server & Routing
PORT=3000

# Backend API URL (Used for Next.js rewrites: /api/:path* -> NEXT_PUBLIC_API_URL/api/:path*)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Payment Gateways
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# Feature Flags
NEXT_PUBLIC_ENABLE_COD=true
