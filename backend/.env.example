# ==============================================================================
# AuraZone Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL via Prisma & pg pool)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aurazone_dev?schema=public

# Authentication & JWT
# Note: Use a cryptographically secure random string in production (e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=604800

# Client URLs (Used for CORS and links generated in transactional emails)
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=AuraZone <noreply@aurazone.shop>

# Cloud Storage (AWS S3 for product images and assets)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET_NAME=aurazone-media-dev

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_DEBUG=false
# RAZORPAY_WEBHOOK_DEBUG_UNTIL=2026-12-31T23:59:59Z

# Web Push Notifications (VAPID)
# Generate new keys using: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@aurazone.shop
